# Usado tanto pelo Vite local (npm run dev) como pelo docker compose.

# Vite (cliente)
VITE_API_URL=http://localhost:3001

# Docker Compose (dev e prod)

# Base de dados MySQL
DB_NAME=lockyapi
DB_USER=locky
DB_PASSWORD=lockypass
DB_ROOT_PASSWORD=rootpass

# Sessao (mesma string que estava no .env da locky-api-m2)
SESSION_SECRET=muda-isto-para-uma-string-aleatoria-longa

# GitHub OAuth (mesmos valores que estavam no .env da locky-api-m2)
GITHUB_CLIENT_ID=preencher
GITHUB_CLIENT_SECRET=preencher
